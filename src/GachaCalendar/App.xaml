<Application x:Class="GachaCalendar.App"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 ShutdownMode="OnExplicitShutdown">
	<Application.Resources>
		<ResourceDictionary>
			<!-- 主题色由 ThemeManager 在启动时按系统浅/深色覆盖（DynamicResource 生效） -->
			<SolidColorBrush x:Key="PanelBg" Color="#F21F2124" />
			<SolidColorBrush x:Key="PanelBorder" Color="#FF35383D" />
			<SolidColorBrush x:Key="Fg" Color="#FFE8EAED" />
			<SolidColorBrush x:Key="FgDim" Color="#FF9AA0A6" />
			<SolidColorBrush x:Key="FgFaint" Color="#FF6B7075" />
			<SolidColorBrush x:Key="Accent" Color="#FF7AB0FF" />
			<SolidColorBrush x:Key="Danger" Color="#FFFF7B7B" />
			<SolidColorBrush x:Key="Warn" Color="#FFE0A458" />
			<SolidColorBrush x:Key="ChipBg" Color="#14FFFFFF" />
			<SolidColorBrush x:Key="ChipBorder" Color="#22FFFFFF" />
			<SolidColorBrush x:Key="DockBg" Color="#E61F2124" />
			<SolidColorBrush x:Key="HoverBg" Color="#1AFFFFFF" />
			<SolidColorBrush x:Key="Divider" Color="#FF2B2E32" />

			<FontFamily x:Key="UiFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>

			<Style TargetType="TextBlock">
				<Setter Property="FontFamily" Value="{StaticResource UiFont}" />
				<Setter Property="Foreground" Value="{DynamicResource Fg}" />
				<Setter Property="FontSize" Value="14" />
				<Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
			</Style>

			<Style x:Key="FlatButton" TargetType="Button">
				<Setter Property="FontFamily" Value="{StaticResource UiFont}" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="Foreground" Value="{DynamicResource FgDim}" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Padding" Value="8,4" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
									<Setter Property="Foreground" Value="{DynamicResource Fg}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
				<Setter Property="Width" Value="28" />
				<Setter Property="Height" Value="28" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="FontSize" Value="15" />
			</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>
