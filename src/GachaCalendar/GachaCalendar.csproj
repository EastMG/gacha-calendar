<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>12</LangVersion>
		<AssemblyName>GachaCalendar</AssemblyName>
		<RootNamespace>GachaCalendar</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<ApplicationIcon>Assets\icon.ico</ApplicationIcon>
		<Version>0.1.6</Version>
		<Authors>EastMG</Authors>
		<Company>EastMG</Company>
		<Product>二游日历 · 任务栏小组件</Product>
		<Description>Windows 11 任务栏常驻的二游卡池与活动日历小组件</Description>
		<Copyright>MIT © 2026 EastMG</Copyright>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<NeutralLanguage>zh-Hans</NeutralLanguage>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\..\data\sample-snapshot.json" LogicalName="sample-snapshot.json" />
	</ItemGroup>

</Project>
