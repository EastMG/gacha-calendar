<Window x:Class="GachaCalendar.Views.DockStripWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="二游日历"
		Width="320" Height="40"
		SizeToContent="Width"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ResizeMode="NoResize"
		ShowInTaskbar="False"
		ShowActivated="False"
		Topmost="True"
		WindowStartupLocation="Manual"
		UseLayoutRounding="True"
		SnapsToDevicePixels="True"
		TextOptions.TextFormattingMode="Display"
		TextOptions.TextRenderingMode="ClearType"
		FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
		Focusable="False">
	<Border x:Name="Shell"
			CornerRadius="13"
			Background="{DynamicResource DockBg}"
			BorderBrush="{DynamicResource PanelBorder}"
			BorderThickness="1"
			Padding="12,0"
			MouseLeftButtonUp="OnClick"
			MouseRightButtonUp="OnRightClick"
			ToolTip="二游日历 · 点击展开面板">
		<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
			<!-- 线框日历图标（与浏览器扩展同一套视觉语言） -->
			<Viewbox Width="16" Height="16" Margin="0,0,8,0">
				<Canvas Width="20" Height="20">
					<Path Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
						  Data="M4,5.5 H16 A1.5,1.5 0 0 1 17.5,7 V16 A1.5,1.5 0 0 1 16,17.5 H4 A1.5,1.5 0 0 1 2.5,16 V7 A1.5,1.5 0 0 1 4,5.5 Z M2.5,9 H17.5 M6.5,3 V6.5 M13.5,3 V6.5" />
				</Canvas>
			</Viewbox>

			<ItemsControl ItemsSource="{Binding Chips}" VerticalAlignment="Center">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="9" Padding="8,2" Margin="3,0" ToolTip="{Binding Tip}">
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Background" Value="{DynamicResource ChipBg}" />
									<Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}" />
									<Setter Property="BorderThickness" Value="1" />
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Background" Value="{DynamicResource HoverBg}" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Ellipse Width="6" Height="6" Fill="{Binding Accent}" VerticalAlignment="Center" />
								<TextBlock Text="{Binding GameName}" Margin="6,0,0,0" FontSize="12"
										   Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
								<TextBlock Text="{Binding Remaining}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
										   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
							</StackPanel>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<TextBlock Text="暂无进行中" FontSize="12" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding HasNoChips}" Value="True">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</StackPanel>
	</Border>
</Window>
