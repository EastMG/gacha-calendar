<Window x:Class="GachaCalendar.Views.DockStripWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="二游日历"
		Width="272" Height="40"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ResizeMode="NoResize"
		ShowInTaskbar="False"
		ShowActivated="False"
		Topmost="True"
		WindowStartupLocation="Manual"
		UseLayoutRounding="True"
		SnapsToDevicePixels="True"
		TextOptions.TextFormattingMode="Ideal"
		TextOptions.TextRenderingMode="ClearType"
		FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
		Focusable="False">
	<Window.Resources>
		<DataTemplate x:Key="DockLineTemplate">
			<Grid Height="26" Width="250" ClipToBounds="True" ToolTip="{Binding Tip}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
					<Path Data="M4,5.5 H16 A1.5,1.5 0 0 1 17.5,7 V16 A1.5,1.5 0 0 1 16,17.5 H4 A1.5,1.5 0 0 1 2.5,16 V7 A1.5,1.5 0 0 1 4,5.5 Z M2.5,9 H17.5 M6.5,3 V6.5 M13.5,3 V6.5"
						  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
						  Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
						  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
						  Visibility="{Binding IdleVisibility}" />
					<Border Width="16" Height="16" CornerRadius="4" ClipToBounds="True"
							Background="{Binding Accent}" Visibility="{Binding ItemVisibility}">
						<Grid>
							<TextBlock Text="{Binding IconGlyph}" FontSize="9" FontWeight="SemiBold" Foreground="White"
									   HorizontalAlignment="Center" VerticalAlignment="Center"
									   Visibility="{Binding GlyphVisibility}" />
							<Image Source="{Binding IconSource}" Stretch="UniformToFill"
								   Visibility="{Binding IconVisibility}" />
						</Grid>
					</Border>
				</Grid>

				<TextBlock Grid.Column="1" Text="{Binding Kind}" Margin="0,0,6,0" VerticalAlignment="Center"
						   FontSize="10" FontWeight="SemiBold" Foreground="{Binding Accent}"
						   Visibility="{Binding KindVisibility}" />

				<TextBlock Grid.Column="2" Text="{Binding ItemName}" VerticalAlignment="Center" ClipToBounds="True"
						   Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="FontSize" Value="12.5" />
							<Setter Property="FontWeight" Value="Normal" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsIdle}" Value="True">
									<Setter Property="FontSize" Value="13" />
									<Setter Property="FontWeight" Value="SemiBold" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>

				<TextBlock Grid.Column="3" Text="{Binding Status}" Margin="8,0,0,0" VerticalAlignment="Center"
						   HorizontalAlignment="Right" Foreground="{Binding StatusBrush}" TextWrapping="NoWrap">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="FontSize" Value="11.5" />
							<Setter Property="FontWeight" Value="SemiBold" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsIdle}" Value="True">
									<Setter Property="FontSize" Value="10.5" />
									<Setter Property="FontWeight" Value="Normal" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</Grid>
		</DataTemplate>
	</Window.Resources>

	<Border x:Name="Shell" CornerRadius="12"
			Background="{DynamicResource DockBg}"
			BorderBrush="{DynamicResource PanelBorder}"
			BorderThickness="1"
			Padding="10,0"
			MouseLeftButtonUp="OnClick"
			MouseRightButtonUp="OnRightClick"
			MouseEnter="OnMouseEnter"
			MouseLeave="OnMouseLeave">
		<Border.Effect>
			<DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.16" Color="Black" />
		</Border.Effect>
		<Grid Height="26" ClipToBounds="True" VerticalAlignment="Center" Background="Transparent">
			<ContentControl x:Name="PrevLine" ContentTemplate="{StaticResource DockLineTemplate}"
							HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
							IsHitTestVisible="False" />
			<ContentControl x:Name="CurrentLine" ContentTemplate="{StaticResource DockLineTemplate}"
							HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
		</Grid>
	</Border>
</Window>
