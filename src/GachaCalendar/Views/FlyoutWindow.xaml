<Window x:Class="GachaCalendar.Views.FlyoutWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="二游日历"
		Width="690" Height="640"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ShowInTaskbar="False"
		Topmost="True"
		ResizeMode="NoResize"
		WindowStartupLocation="Manual"
		FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
	<Window.Resources>
		<Style x:Key="DshIconButton" TargetType="Button">
			<Setter Property="Width" Value="24" />
			<Setter Property="Height" Value="24" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DshRefreshButton" TargetType="Button" BasedOn="{StaticResource DshIconButton}">
			<Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
		</Style>

		<Style x:Key="DshCellText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
		</Style>

		<Style x:Key="DshHeaderText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</Window.Resources>

	<Border CornerRadius="12" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
		<Border.Effect>
			<DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.25" Color="Black" />
		</Border.Effect>

		<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,10,10,8">
			<StackPanel>
				<!-- 标题 + 操作（DSH 面板：13px semibold，右侧小按钮） -->
				<Grid Margin="0,0,0,4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="二游日历" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
					<StackPanel Grid.Column="1" Orientation="Horizontal">
						<Button Style="{StaticResource DshRefreshButton}" IsEnabled="{Binding CanRefresh}"
								ToolTip="{Binding RefreshTip}" Click="OnRefresh" Margin="0,0,4,0">
							<Path Data="M21 12a9 9 0 1 1-2.64-6.36L21 8 M21 3 L21 8 L16 8"
								  Stroke="{DynamicResource Fg}" StrokeThickness="2.2" StrokeStartLineCap="Round"
								  StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" />
						</Button>
						<Button Style="{StaticResource DshIconButton}" ToolTip="设置" Click="OnSettings">
							<TextBlock Text="⚙" FontSize="14" Foreground="{DynamicResource Fg}" />
						</Button>
					</StackPanel>
				</Grid>

				<!-- 数据状态 / 刷新时间 / 抓取提示 -->
				<Grid Margin="0,0,0,8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="{Binding DataStatusText}" FontSize="11" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
					<TextBlock Grid.Column="1" Text="{Binding UpdatedText}" FontSize="11" Foreground="{DynamicResource FgDim}"
							   Margin="12,0,0,0" VerticalAlignment="Center" />
					<TextBlock Grid.Column="2" Text="{Binding ScrapeText}" FontSize="11" Foreground="{DynamicResource FgFaint}"
							   Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
							   ToolTip="{Binding StatusTip}" />
				</Grid>

				<!-- 表头 -->
				<Grid Margin="0,0,0,2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="22" />
						<ColumnDefinition Width="96" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="150" />
						<ColumnDefinition Width="1.3*" />
						<ColumnDefinition Width="150" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="1" Text="游戏" Style="{StaticResource DshHeaderText}" />
					<TextBlock Grid.Column="2" Text="当前卡池" Style="{StaticResource DshHeaderText}" />
					<TextBlock Grid.Column="3" Text="卡池起止" Style="{StaticResource DshHeaderText}" />
					<TextBlock Grid.Column="4" Text="当前活动" Style="{StaticResource DshHeaderText}" />
					<TextBlock Grid.Column="5" Text="活动起止" Style="{StaticResource DshHeaderText}" />
				</Grid>

				<!-- 行 -->
				<ItemsControl ItemsSource="{Binding Rows}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,5">
								<Border.Style>
									<Style TargetType="Border">
										<Style.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background" Value="{DynamicResource HoverBg}" />
											</Trigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="22" />
										<ColumnDefinition Width="96" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="150" />
										<ColumnDefinition Width="1.3*" />
										<ColumnDefinition Width="150" />
									</Grid.ColumnDefinitions>

									<!-- 图标：外链加载失败时退化为首字方块（与 DSH 同一策略） -->
									<Grid Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Center">
										<Border x:Name="IconFallback" CornerRadius="5" Background="{Binding IconBrush}">
											<Border.Style>
												<Style TargetType="Border">
													<Setter Property="Visibility" Value="Visible" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding HasIcon}" Value="True">
															<Setter Property="Visibility" Value="Collapsed" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Border.Style>
											<TextBlock Text="{Binding IconGlyph}" FontSize="11" Foreground="White"
													   HorizontalAlignment="Center" VerticalAlignment="Center" />
										</Border>
										<Image Source="{Binding IconSource}" Stretch="UniformToFill">
											<Image.Style>
												<Style TargetType="Image">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding HasIcon}" Value="True">
															<Setter Property="Visibility" Value="Visible" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Image.Style>
											<Image.Clip>
												<RectangleGeometry Rect="0,0,20,20" RadiusX="5" RadiusY="5" />
											</Image.Clip>
										</Image>
									</Grid>

									<TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource DshCellText}"
											   FontWeight="SemiBold" Margin="3,0" ToolTip="{Binding Name}" />

									<TextBlock Grid.Column="2" Text="{Binding GachaText}" Style="{StaticResource DshCellText}"
											   Margin="6,0" ToolTip="{Binding GachaTip}" />

									<TextBlock Grid.Column="3" Text="{Binding GachaDateText}" Style="{StaticResource DshCellText}"
											   Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
											   Margin="3,0" ToolTip="{Binding GachaDateTip}" />

									<TextBlock Grid.Column="4" Text="{Binding EventText}" Style="{StaticResource DshCellText}"
											   Margin="6,0" ToolTip="{Binding EventTip}" />

									<TextBlock Grid.Column="5" Text="{Binding EventDateText}" Style="{StaticResource DshCellText}"
											   Foreground="{DynamicResource FgDim}" Margin="3,0"
											   ToolTip="{Binding EventDateTip}" />
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- 载入失败 -->
				<StackPanel Margin="12,16,12,8" HorizontalAlignment="Center">
					<StackPanel.Style>
						<Style TargetType="StackPanel">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding HasError}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</StackPanel.Style>
					<TextBlock Text="载入失败" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Danger}" />
					<TextBlock Text="{Binding ErrorText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
							   MaxWidth="600" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Border>
</Window>
