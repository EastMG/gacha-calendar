<Window x:Class="GachaCalendar.Views.FlyoutWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:GachaCalendar.Controls"
		xmlns:views="clr-namespace:GachaCalendar.Views"
		Title="二游日历"
		Width="690" Height="640"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ShowInTaskbar="False"
		Topmost="True"
		ResizeMode="NoResize"
		WindowStartupLocation="Manual"
		UseLayoutRounding="True"
		SnapsToDevicePixels="True"
		TextOptions.TextFormattingMode="Display"
		TextOptions.TextRenderingMode="ClearType"
		FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">
	<Window.Resources>
		<Style x:Key="DshIconButton" TargetType="Button">
			<Setter Property="Width" Value="24" />
			<Setter Property="Height" Value="24" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DshRefreshButton" TargetType="Button" BasedOn="{StaticResource DshIconButton}">
			<Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
		</Style>

		<Style x:Key="DshCellText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
		</Style>

		<Style x:Key="DshHeaderText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!-- DSH 风格细滚动条：深色主题下也不出现系统浅色滚动条 -->
		<Style x:Key="DshThinScrollBar" TargetType="ScrollBar">
			<Setter Property="Width" Value="8" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollBar">
						<Grid Width="8" Background="Transparent">
							<Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
								<Track.DecreaseRepeatButton>
									<RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
								</Track.DecreaseRepeatButton>
								<Track.Thumb>
									<Thumb Width="8">
										<Thumb.Template>
											<ControlTemplate TargetType="Thumb">
												<Border Background="{DynamicResource FgFaint}" CornerRadius="4" Opacity="0.65" Margin="1,2" />
											</ControlTemplate>
										</Thumb.Template>
									</Thumb>
								</Track.Thumb>
								<Track.IncreaseRepeatButton>
									<RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
								</Track.IncreaseRepeatButton>
							</Track>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DshScrollViewer" TargetType="ScrollViewer">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollViewer">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0"
													Margin="{TemplateBinding Padding}"
													Content="{TemplateBinding Content}"
													ContentTemplate="{TemplateBinding ContentTemplate}"
													CanContentScroll="{TemplateBinding CanContentScroll}" />
							<ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="8"
									   Orientation="Vertical" Cursor="Arrow"
									   Style="{StaticResource DshThinScrollBar}"
									   Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
									   Maximum="{TemplateBinding ScrollableHeight}"
									   ViewportSize="{TemplateBinding ViewportHeight}"
									   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border CornerRadius="12" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
		<Border.Effect>
			<DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.25" Color="Black" />
		</Border.Effect>

		<Grid>
			<ScrollViewer x:Name="TableScroll" Style="{StaticResource DshScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,10,10,8">
			<StackPanel>
				<!-- 标题 + 操作（DSH 面板：13px semibold，右侧小按钮） -->
				<Grid Margin="0,0,0,4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="二游日历" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
					<StackPanel Grid.Column="1" Orientation="Horizontal">
						<Button Style="{StaticResource DshRefreshButton}" IsEnabled="{Binding CanRefresh}"
								ToolTip="{Binding RefreshTip}" Click="OnRefresh" Margin="0,0,4,0">
							<Path x:Name="RefreshIcon" Data="M21 12a9 9 0 1 1-2.64-6.36L21 8 M21 3 L21 8 L16 8"
								  Stroke="{DynamicResource Fg}" StrokeThickness="2.2" StrokeStartLineCap="Round"
								  StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform"
								  RenderTransformOrigin="0.5,0.5">
								<Path.RenderTransform>
									<RotateTransform Angle="0" />
								</Path.RenderTransform>
							</Path>
						</Button>
						<Button Style="{StaticResource DshIconButton}" ToolTip="设置" Click="OnSettings">
							<TextBlock Text="⚙" FontSize="14" Foreground="{DynamicResource Fg}" />
						</Button>
					</StackPanel>
				</Grid>

				<!-- 数据状态 / 刷新时间 / 抓取提示 -->
				<Grid Margin="0,0,0,8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="{Binding DataStatusText}" FontSize="11" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
					<TextBlock Grid.Column="1" Text="{Binding UpdatedText}" FontSize="11" Foreground="{DynamicResource FgDim}"
							   Margin="12,0,0,0" VerticalAlignment="Center" />
					<TextBlock Grid.Column="2" Text="{Binding ScrapeText}" FontSize="11" Foreground="{DynamicResource FgFaint}"
							   Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
							   ToolTip="{Binding StatusTip}" />
				</Grid>

				<!-- 表头 -->
				<Grid Margin="0,0,0,2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="22" />
						<ColumnDefinition Width="96" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="150" />
						<ColumnDefinition Width="1.3*" />
						<ColumnDefinition Width="150" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="1" Text="游戏" Style="{StaticResource DshHeaderText}" />
					<TextBlock Grid.Column="2" Text="当前卡池" Style="{StaticResource DshHeaderText}" />
					<TextBlock Grid.Column="3" Text="卡池起止" Style="{StaticResource DshHeaderText}" />
					<TextBlock Grid.Column="4" Text="当前活动" Style="{StaticResource DshHeaderText}" />
					<TextBlock Grid.Column="5" Text="活动起止" Style="{StaticResource DshHeaderText}" />
				</Grid>

				<!-- 行 -->
				<ItemsControl ItemsSource="{Binding Rows}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,5">
								<Border.Style>
									<Style TargetType="Border">
										<Style.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background" Value="{DynamicResource HoverBg}" />
											</Trigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="22" />
										<ColumnDefinition Width="96" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="150" />
										<ColumnDefinition Width="1.3*" />
										<ColumnDefinition Width="150" />
									</Grid.ColumnDefinitions>

									<!-- 图标：外链加载失败时退化为首字方块（与 DSH 同一策略） -->
									<Grid Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Center">
										<Border x:Name="IconFallback" CornerRadius="5" Background="{Binding IconBrush}">
											<Border.Style>
												<Style TargetType="Border">
													<Setter Property="Visibility" Value="Visible" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding HasIcon}" Value="True">
															<Setter Property="Visibility" Value="Collapsed" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Border.Style>
											<TextBlock Text="{Binding IconGlyph}" FontSize="11" Foreground="White"
													   HorizontalAlignment="Center" VerticalAlignment="Center" />
										</Border>
										<Image Source="{Binding IconSource}" Stretch="UniformToFill">
											<Image.Style>
												<Style TargetType="Image">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding HasIcon}" Value="True">
															<Setter Property="Visibility" Value="Visible" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Image.Style>
											<Image.Clip>
												<RectangleGeometry Rect="0,0,20,20" RadiusX="5" RadiusY="5" />
											</Image.Clip>
										</Image>
									</Grid>

									<Border Grid.Column="1" Margin="3,0" ClipToBounds="True">
										<TextBlock Text="{Binding Name}" Style="{StaticResource DshCellText}" FontWeight="SemiBold"
												   ToolTip="{Binding Name}" controls:Marquee.Enabled="True" />
									</Border>

									<Border Grid.Column="2" Margin="6,0" ClipToBounds="True">
										<TextBlock Text="{Binding GachaText}" Style="{StaticResource DshCellText}"
												   ToolTip="{Binding GachaTip}" controls:Marquee.Enabled="True" />
									</Border>

									<Border Grid.Column="3" Margin="3,0" ClipToBounds="True">
										<TextBlock Text="{Binding GachaDateText}" Style="{StaticResource DshCellText}"
												   Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
												   ToolTip="{Binding GachaDateTip}" controls:Marquee.Enabled="True" />
									</Border>

									<Border Grid.Column="4" Margin="6,0" ClipToBounds="True">
										<TextBlock Text="{Binding EventText}" Style="{StaticResource DshCellText}"
												   ToolTip="{Binding EventTip}" controls:Marquee.Enabled="True" />
									</Border>

									<Border Grid.Column="5" Margin="3,0" ClipToBounds="True">
										<TextBlock Text="{Binding EventDateText}" Style="{StaticResource DshCellText}"
												   Foreground="{DynamicResource FgDim}" ToolTip="{Binding EventDateTip}"
												   controls:Marquee.Enabled="True" />
									</Border>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- 载入失败 -->
				<StackPanel Margin="12,16,12,8" HorizontalAlignment="Center">
					<StackPanel.Style>
						<Style TargetType="StackPanel">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding HasError}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</StackPanel.Style>
					<TextBlock Text="载入失败" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Danger}" />
					<TextBlock Text="{Binding ErrorText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
							   MaxWidth="600" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
			<views:ScheduleView x:Name="SchedulePanel" DataContext="{Binding Schedule}" Visibility="Collapsed" />
		</Grid>
	</Border>
</Window>
