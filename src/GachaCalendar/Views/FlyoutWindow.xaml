<Window x:Class="GachaCalendar.Views.FlyoutWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="二游日历"
		Width="520" Height="640"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ShowInTaskbar="False"
		Topmost="True"
		ResizeMode="NoResize"
		WindowStartupLocation="Manual">
	<Border CornerRadius="14" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
		<Border.Effect>
			<DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.35" Color="Black" />
		</Border.Effect>
		<DockPanel>

			<!-- 头部 -->
			<Border DockPanel.Dock="Top" Padding="14,12,12,10" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="二游日历" FontSize="16" FontWeight="SemiBold" />
							<Border Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1"
									CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
								<TextBlock Text="{Binding HeaderCount}" FontSize="11" Foreground="{DynamicResource FgDim}" />
							</Border>
						</StackPanel>
						<TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,5,0,0"
								   Foreground="{DynamicResource FgDim}" ToolTip="{Binding StatusTip}" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Top">
						<Button Style="{StaticResource IconButton}" Content="⟳" ToolTip="重新读取快照（抓取请运行 cd tools; npm run refresh）" Click="OnReload" />
						<Button Style="{StaticResource IconButton}" Content="⚙" ToolTip="设置" Click="OnSettings" />
						<Button Style="{StaticResource IconButton}" Content="✕" ToolTip="关闭" Click="OnClose" />
					</StackPanel>
				</Grid>
			</Border>

			<!-- 底部 -->
			<Border DockPanel.Dock="Bottom" Padding="14,8" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
				<Grid>
					<TextBlock Text="{Binding UpdatedText}" FontSize="11" Foreground="{DynamicResource FgFaint}" />
					<TextBlock Text="悬停查看池名与时间明细" FontSize="11" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Right" />
				</Grid>
			</Border>

			<!-- 列表 -->
			<Grid>
				<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2,0,2">
					<ItemsControl ItemsSource="{Binding Rows}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Padding="14,8" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
									<StackPanel>
										<DockPanel>
											<Border DockPanel.Dock="Right" CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
												<Border.Style>
													<Style TargetType="Border">
														<Setter Property="Visibility" Value="Collapsed" />
														<Setter Property="BorderBrush" Value="{DynamicResource FgFaint}" />
														<Setter Property="BorderThickness" Value="1" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding HasBadge}" Value="True">
																<Setter Property="Visibility" Value="Visible" />
															</DataTrigger>
															<DataTrigger Binding="{Binding BadgeKind}" Value="err">
																<Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
															</DataTrigger>
															<DataTrigger Binding="{Binding BadgeKind}" Value="warn">
																<Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
												<TextBlock Text="{Binding BadgeText}" FontSize="10">
													<TextBlock.Style>
														<Style TargetType="TextBlock">
															<Setter Property="Foreground" Value="{DynamicResource FgDim}" />
															<Style.Triggers>
																<DataTrigger Binding="{Binding BadgeKind}" Value="err">
																	<Setter Property="Foreground" Value="{DynamicResource Danger}" />
																</DataTrigger>
																<DataTrigger Binding="{Binding BadgeKind}" Value="warn">
																	<Setter Property="Foreground" Value="{DynamicResource Warn}" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</TextBlock.Style>
												</TextBlock>
											</Border>
											<TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
										</DockPanel>

										<Grid Margin="0,4,0,0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="34" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>

											<TextBlock Grid.Row="0" Grid.Column="0" Text="卡池" FontSize="11" Foreground="{DynamicResource FgFaint}" />
											<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GachaText}" ToolTip="{Binding GachaTip}"
													   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />

											<TextBlock Grid.Row="1" Grid.Column="0" Text="起止" FontSize="11" Foreground="{DynamicResource FgFaint}" />
											<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GachaDateText}" ToolTip="{Binding GachaDateTip}"
													   FontSize="11" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" />

											<TextBlock Grid.Row="2" Grid.Column="0" Text="活动" FontSize="11" Foreground="{DynamicResource FgFaint}" />
											<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EventText}" ToolTip="{Binding EventTip}"
													   FontSize="12" TextTrimming="CharacterEllipsis" />

											<TextBlock Grid.Row="3" Grid.Column="0" Text="起止" FontSize="11" Foreground="{DynamicResource FgFaint}" />
											<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EventDateText}" ToolTip="{Binding EventDateTip}"
													   FontSize="11" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" />
										</Grid>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<!-- 错误/空状态 -->
				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
					<StackPanel.Style>
						<Style TargetType="StackPanel">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding HasError}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</StackPanel.Style>
					<TextBlock Text="载入失败" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Danger}" />
					<TextBlock Text="{Binding ErrorText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" />
				</StackPanel>
			</Grid>
		</DockPanel>
	</Border>
</Window>
