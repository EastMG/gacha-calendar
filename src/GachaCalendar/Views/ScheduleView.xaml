<UserControl x:Class="GachaCalendar.Views.ScheduleView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 UseLayoutRounding="True"
			 SnapsToDevicePixels="True"
			 TextOptions.TextFormattingMode="Display"
			 TextOptions.TextRenderingMode="ClearType"
			 FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">
	<UserControl.Resources>
		<Style x:Key="SchedThinScrollBar" TargetType="ScrollBar">
			<Setter Property="Width" Value="8" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollBar">
						<Grid Width="8" Background="Transparent">
							<Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
								<Track.DecreaseRepeatButton>
									<RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
								</Track.DecreaseRepeatButton>
								<Track.Thumb>
									<Thumb Width="8">
										<Thumb.Template>
											<ControlTemplate TargetType="Thumb">
												<Border Background="{DynamicResource FgFaint}" CornerRadius="4" Opacity="0.65" Margin="1,2" />
											</ControlTemplate>
										</Thumb.Template>
									</Thumb>
								</Track.Thumb>
								<Track.IncreaseRepeatButton>
									<RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
								</Track.IncreaseRepeatButton>
							</Track>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="SchedScrollViewer" TargetType="ScrollViewer">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollViewer">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0"
													Margin="{TemplateBinding Padding}"
													Content="{TemplateBinding Content}"
													ContentTemplate="{TemplateBinding ContentTemplate}"
													CanContentScroll="{TemplateBinding CanContentScroll}" />
							<ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="8"
									   Orientation="Vertical" Cursor="Arrow"
									   Style="{StaticResource SchedThinScrollBar}"
									   Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
									   Maximum="{TemplateBinding ScrollableHeight}"
									   ViewportSize="{TemplateBinding ViewportHeight}"
									   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="SchedHint" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
		</Style>
		<Style x:Key="SchedCellTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>
		<Style x:Key="SchedCellMeta" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>
		<Style x:Key="SchedLinkButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{DynamicResource FgDim}" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999" Padding="8,3">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid Margin="12,12,12,10">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0" Style="{StaticResource SchedScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<StackPanel>
				<!-- 头部：总览 + 日期胶囊 -->
				<Grid Margin="0,0,0,10">
					<TextBlock Text="{Binding GlanceText}" FontSize="12" Foreground="{DynamicResource FgDim}"
							   VerticalAlignment="Center" />
					<Border HorizontalAlignment="Right" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource PanelBorder}"
							BorderThickness="1" CornerRadius="999" Padding="9,2">
						<TextBlock Text="{Binding DatePill}" FontSize="11" Foreground="{DynamicResource Accent}" />
					</Border>
				</Grid>

				<!-- 近期 + 悬停详情卡 -->
				<Grid Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="63*" />
						<ColumnDefinition Width="37*" />
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" Margin="0,0,10,0" MouseEnter="OnUrgentAreaEnter" MouseLeave="OnUrgentAreaLeave">
						<ItemsControl ItemsSource="{Binding Urgent}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Padding="8,5" CornerRadius="10" MouseEnter="OnUrgentEnter"
											ToolTip="{Binding Tip}">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="Transparent" />
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="{DynamicResource HoverBg}" />
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="26" />
												<ColumnDefinition Width="78" />
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
												<Border CornerRadius="5" Background="{Binding GameColor}">
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Visibility" Value="Visible" />
															<Style.Triggers>
																<DataTrigger Binding="{Binding HasIcon}" Value="True">
																	<Setter Property="Visibility" Value="Collapsed" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock Text="{Binding IconGlyph}" FontSize="10" Foreground="White"
															   HorizontalAlignment="Center" VerticalAlignment="Center" />
												</Border>
												<Image Source="{Binding Icon}" Stretch="UniformToFill">
													<Image.Style>
														<Style TargetType="Image">
															<Setter Property="Visibility" Value="Collapsed" />
															<Style.Triggers>
																<DataTrigger Binding="{Binding HasIcon}" Value="True">
																	<Setter Property="Visibility" Value="Visible" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Image.Style>
												</Image>
											</Grid>
											<TextBlock Grid.Column="1" Text="{Binding GameName}" FontSize="12.5"
													   Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"
													   TextTrimming="CharacterEllipsis" Margin="5,0,0,0" />
											<Border Grid.Column="2" CornerRadius="4" Padding="4,1" Margin="3,0" VerticalAlignment="Center">
												<Border.Style>
													<Style TargetType="Border">
														<Setter Property="Background" Value="#143B5BFD" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding IsGacha}" Value="False">
																<Setter Property="Background" Value="#14B45309" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
												<Grid>
													<TextBlock Text="卡池" FontSize="10" Foreground="{DynamicResource Accent}">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Visibility" Value="Visible" />
																<Style.Triggers>
																	<DataTrigger Binding="{Binding IsGacha}" Value="False">
																		<Setter Property="Visibility" Value="Collapsed" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
													<TextBlock Text="活动" FontSize="10" Foreground="{DynamicResource Warn}">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Visibility" Value="Collapsed" />
																<Style.Triggers>
																	<DataTrigger Binding="{Binding IsGacha}" Value="False">
																		<Setter Property="Visibility" Value="Visible" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</Grid>
											</Border>
											<TextBlock Grid.Column="3" Text="{Binding Show}" FontSize="13" FontWeight="SemiBold"
													   VerticalAlignment="Center" Margin="3,0" TextTrimming="CharacterEllipsis"
													   ToolTip="{Binding Tip}" />
											<TextBlock Grid.Column="4" Text="{Binding WhenText}" FontSize="12.5" FontWeight="SemiBold"
													   VerticalAlignment="Center" Margin="6,0,0,0">
												<TextBlock.Style>
													<Style TargetType="TextBlock">
														<Setter Property="Foreground" Value="{DynamicResource FgDim}" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding Urgency}" Value="1">
																<Setter Property="Foreground" Value="{DynamicResource Danger}" />
															</DataTrigger>
															<DataTrigger Binding="{Binding Urgency}" Value="2">
																<Setter Property="Foreground" Value="{DynamicResource Warn}" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<Button Content="{Binding ExpandText}" Click="OnExpand"
								HorizontalAlignment="Center" Margin="0,4,0,0">
							<Button.Style>
								<Style TargetType="Button" BasedOn="{StaticResource SchedLinkButton}">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasExpand}" Value="True">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>
					</StackPanel>

					<!-- 下一个截止卡（悬停近期行时切换） -->
					<Border Grid.Column="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
							BorderThickness="1" CornerRadius="12" Padding="12" VerticalAlignment="Stretch">
						<StackPanel>
							<Grid Width="68" Height="68" HorizontalAlignment="Center" Margin="0,2,0,0">
								<Ellipse Stroke="{Binding Focus.GameColor}" StrokeThickness="2" Opacity="0.45" Margin="-5" />
								<Border CornerRadius="34" Background="{Binding Focus.GameColor}">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Visibility" Value="Visible" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding Focus.HasIcon}" Value="True">
													<Setter Property="Visibility" Value="Collapsed" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
									<TextBlock Text="{Binding Focus.IconGlyph}" FontSize="23" Foreground="White"
											   HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Border>
								<Image Source="{Binding Focus.Icon}" Stretch="UniformToFill">
									<Image.Style>
										<Style TargetType="Image">
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding Focus.HasIcon}" Value="True">
													<Setter Property="Visibility" Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Image.Style>
									<Image.Clip>
										<EllipseGeometry Center="34,34" RadiusX="34" RadiusY="34" />
									</Image.Clip>
								</Image>
							</Grid>
							<TextBlock Text="{Binding FocusGameName}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center"
									   Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
								<TextBlock Text="{Binding Focus.FocusNumber}" FontSize="30" FontWeight="SemiBold" />
								<TextBlock Text="{Binding Focus.FocusUnit}" FontSize="11" Foreground="{DynamicResource FgDim}"
										   VerticalAlignment="Bottom" Margin="4,0,0,5" />
							</StackPanel>
							<TextBlock Text="{Binding FocusTitle}" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap"
									   Margin="0,5,0,0" MaxHeight="36" />
							<TextBlock Text="{Binding FocusDates}" FontSize="10.5" Foreground="{DynamicResource FgFaint}"
									   TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
							<Separator Margin="0,8,0,6" Background="{DynamicResource Divider}" />
							<ItemsControl ItemsSource="{Binding FocusOthers}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid Margin="0,3">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="18" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<Grid Width="16" Height="16" VerticalAlignment="Center">
												<Border CornerRadius="8" Background="{Binding GameColor}" />
											</Grid>
											<StackPanel Grid.Column="1" Margin="5,0,4,0">
												<TextBlock Text="{Binding GameName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding Title}" FontSize="10" Foreground="{DynamicResource FgFaint}" TextTrimming="CharacterEllipsis" />
											</StackPanel>
											<TextBlock Grid.Column="2" Text="{Binding WhenText}" FontSize="10" Foreground="{DynamicResource FgDim}"
													   VerticalAlignment="Center" />
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
				</Grid>

				<!-- 游戏日程表 -->
				<Grid Margin="0,2,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="158" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="游戏" Style="{StaticResource SchedHint}" Margin="8,0,0,0" />
					<TextBlock Grid.Column="1" Text="◆ 卡池" Style="{StaticResource SchedHint}" Foreground="{DynamicResource Accent}" Margin="12,0,0,0" />
					<TextBlock Grid.Column="2" Text="⚑ 活动" Style="{StaticResource SchedHint}" Foreground="{DynamicResource Warn}" Margin="12,0,0,0" />
				</Grid>
				<Grid Margin="0,2,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="158" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<ItemsControl Grid.Column="1" ItemsSource="{Binding Days}" Margin="12,0,0,0">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate><UniformGrid Columns="14" /></ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Day}" FontSize="8" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="FontWeight" Value="Normal" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding Today}" Value="True">
													<Setter Property="FontWeight" Value="SemiBold" />
													<Setter Property="Foreground" Value="{DynamicResource Fg}" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<ItemsControl Grid.Column="2" ItemsSource="{Binding Days}" Margin="12,0,0,0">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate><UniformGrid Columns="14" /></ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Day}" FontSize="8" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="FontWeight" Value="Normal" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding Today}" Value="True">
													<Setter Property="FontWeight" Value="SemiBold" />
													<Setter Property="Foreground" Value="{DynamicResource Fg}" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Grid>
				<Border Height="1" Background="{DynamicResource Divider}" Margin="0,3,0,2" />

				<ItemsControl ItemsSource="{Binding Rows}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,8">
								<Border.Style>
									<Style TargetType="Border">
										<Style.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background" Value="{DynamicResource HoverBg}" />
											</Trigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="158" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
										<Grid Width="40" Height="40">
											<Border CornerRadius="10" Background="{Binding GameColor}">
												<Border.Style>
													<Style TargetType="Border">
														<Setter Property="Visibility" Value="Visible" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding HasIcon}" Value="True">
																<Setter Property="Visibility" Value="Collapsed" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
												<TextBlock Text="{Binding IconGlyph}" FontSize="16" Foreground="White"
														   HorizontalAlignment="Center" VerticalAlignment="Center" />
											</Border>
											<Image Source="{Binding Icon}" Stretch="UniformToFill">
												<Image.Style>
													<Style TargetType="Image">
														<Setter Property="Visibility" Value="Collapsed" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding HasIcon}" Value="True">
																<Setter Property="Visibility" Value="Visible" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Image.Style>
												<Image.Clip>
													<RectangleGeometry Rect="0,0,40,40" RadiusX="10" RadiusY="10" />
												</Image.Clip>
											</Image>
										</Grid>
										<TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
												   Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="96" />
									</StackPanel>

									<StackPanel x:Name="GachaCell" Grid.Column="1" Margin="12,0,8,0"
												Tag="{Binding Gacha}" MouseEnter="OnProbeEnter" MouseLeave="OnProbeLeave">
										<TextBlock Text="{Binding Gacha.Show, TargetNullValue=—}" Style="{StaticResource SchedCellTitle}"
												   ToolTip="{Binding Gacha.Tip}" />
										<TextBlock Text="{Binding Gacha.MetaText, TargetNullValue=该来源无数据}" Style="{StaticResource SchedCellMeta}"
												   FontSize="10" />
										<ItemsControl ItemsSource="{Binding Gacha.Bars}" Margin="0,3,0,0">
											<ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border Height="10" Margin="0.5,0">
														<Border.Style>
															<Style TargetType="Border">
																<Setter Property="Background" Value="Transparent" />
																<Setter Property="CornerRadius" Value="1" />
																<Style.Triggers>
																	<DataTrigger Binding="{Binding Filled}" Value="True">
																		<Setter Property="Background" Value="{Binding Color}" />
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Today}" Value="True">
																		<Setter Property="BorderBrush" Value="{DynamicResource FgFaint}" />
																		<Setter Property="BorderThickness" Value="0,0,0,1" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</Border.Style>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
										<Popup PlacementTarget="{Binding ElementName=GachaCell}" Placement="Bottom"
											   IsOpen="{Binding IsProbeOpen}" AllowsTransparency="True" StaysOpen="False"
											   PopupAnimation="Fade" DataContext="{Binding Gacha}">
											<Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
													BorderThickness="1" CornerRadius="8" Padding="10" MaxWidth="320">
												<StackPanel>
													<TextBlock Text="同格档期" FontSize="10" Foreground="{DynamicResource FgFaint}" Margin="0,0,0,4" />
													<ItemsControl ItemsSource="{Binding Extras}">
														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<StackPanel Margin="0,3">
																	<TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
																			   TextTrimming="CharacterEllipsis" />
																	<TextBlock Text="{Binding WhenText}" FontSize="11" Foreground="{DynamicResource FgDim}" />
																	<TextBlock Text="{Binding WindowText}" FontSize="10" Foreground="{DynamicResource FgFaint}" />
																</StackPanel>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</StackPanel>
											</Border>
										</Popup>
									</StackPanel>

									<StackPanel x:Name="EventCell" Grid.Column="2" Margin="12,0,8,0"
												Tag="{Binding Event}" MouseEnter="OnProbeEnter" MouseLeave="OnProbeLeave">
										<TextBlock Text="{Binding Event.Show, TargetNullValue=—}" Style="{StaticResource SchedCellTitle}"
												   ToolTip="{Binding Event.Tip}" />
										<TextBlock Text="{Binding Event.MetaText, TargetNullValue=该来源无数据}" Style="{StaticResource SchedCellMeta}"
												   FontSize="10" />
										<ItemsControl ItemsSource="{Binding Event.Bars}" Margin="0,3,0,0">
											<ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border Height="10" Margin="0.5,0">
														<Border.Style>
															<Style TargetType="Border">
																<Setter Property="Background" Value="Transparent" />
																<Setter Property="CornerRadius" Value="1" />
																<Style.Triggers>
																	<DataTrigger Binding="{Binding Filled}" Value="True">
																		<Setter Property="Background" Value="{Binding Color}" />
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Today}" Value="True">
																		<Setter Property="BorderBrush" Value="{DynamicResource FgFaint}" />
																		<Setter Property="BorderThickness" Value="0,0,0,1" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</Border.Style>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
										<Popup PlacementTarget="{Binding ElementName=EventCell}" Placement="Bottom"
											   IsOpen="{Binding IsProbeOpen}" AllowsTransparency="True" StaysOpen="False"
											   PopupAnimation="Fade" DataContext="{Binding Event}">
											<Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
													BorderThickness="1" CornerRadius="8" Padding="10" MaxWidth="320">
												<StackPanel>
													<TextBlock Text="同格档期" FontSize="10" Foreground="{DynamicResource FgFaint}" Margin="0,0,0,4" />
													<ItemsControl ItemsSource="{Binding Extras}">
														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<StackPanel Margin="0,3">
																	<TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
																			   TextTrimming="CharacterEllipsis" />
																	<TextBlock Text="{Binding WhenText}" FontSize="11" Foreground="{DynamicResource FgDim}" />
																	<TextBlock Text="{Binding WindowText}" FontSize="10" Foreground="{DynamicResource FgFaint}" />
																</StackPanel>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</StackPanel>
											</Border>
										</Popup>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- 刷新失败横条：来源级失败（沿用上次成功数据） -->
				<Border Margin="0,6,0,2" Padding="8,4" CornerRadius="6" Background="#14D9484D" ToolTip="{Binding FailureTip}">
					<Border.Style>
						<Style TargetType="Border">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding HasFailure}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock Text="!" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" Margin="0,0,6,0" />
						<TextBlock Grid.Column="1" Text="{Binding FailureText}" FontSize="11" Foreground="{DynamicResource Danger}"
								   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
						<Button Grid.Column="2" Content="重试" Style="{StaticResource SchedLinkButton}" Click="OnRefresh"
								Foreground="{DynamicResource Danger}" />
					</Grid>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<!-- 底栏常驻 -->
		<Border Grid.Row="1" Margin="0,6,0,0" Padding="0,6,0,0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="{Binding ScrapeText}" FontSize="11" Foreground="{DynamicResource FgFaint}"
						   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
				<TextBlock Grid.Column="1" Text="{Binding UpdatedAgo}" FontSize="11" Foreground="{DynamicResource FgFaint}"
						   VerticalAlignment="Center" Margin="8,0" />
				<Button Grid.Column="2" Content="刷新" Style="{StaticResource SchedLinkButton}" Click="OnRefresh"
						Foreground="{DynamicResource Accent}" />
			</Grid>
		</Border>
	</Grid>
</UserControl>
