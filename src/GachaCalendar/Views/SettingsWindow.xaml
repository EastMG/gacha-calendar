<Window x:Class="GachaCalendar.Views.SettingsWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="设置 — 二游日历"
		Width="780" Height="780"
		MinWidth="720" MinHeight="600"
		WindowStartupLocation="CenterScreen"
		UseLayoutRounding="True"
		SnapsToDevicePixels="True"
		TextOptions.TextFormattingMode="Display"
		TextOptions.TextRenderingMode="ClearType"
		Background="{DynamicResource PanelBg}"
		Foreground="{DynamicResource Fg}"
		FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">
	<Window.Resources>
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource ChipBg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="14" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>
		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
		</Style>
		<Style x:Key="Hint" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style x:Key="SmallButton" TargetType="Button">
			<Setter Property="Padding" Value="10,3" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Background" Value="{DynamicResource PanelBg}" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.4" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 设置页控件统一到 DSH 的浅色卡片观感 -->
		<Style TargetType="ComboBox">
			<Setter Property="Height" Value="26" />
			<Setter Property="Padding" Value="6,2" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Background" Value="{DynamicResource PanelBg}" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
										  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border x:Name="Bd" Background="{DynamicResource PanelBg}"
												BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="6">
											<Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource FgDim}" StrokeThickness="1.2"
												  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>
							<ContentPresenter Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"
											  Content="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" />
							<Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
								   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
								<Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
										BorderThickness="1" CornerRadius="6" MinWidth="180" MaxHeight="260"
										Padding="2">
									<ScrollViewer VerticalScrollBarVisibility="Auto">
										<ItemsPresenter />
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="ComboBoxItem">
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBoxItem">
						<Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,4">
							<ContentPresenter Content="{Binding Label}" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsHighlighted" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipBg}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="TextBox">
			<Setter Property="Height" Value="26" />
			<Setter Property="Padding" Value="6,2" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Background" Value="{DynamicResource PanelBg}" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style TargetType="CheckBox">
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<StackPanel Orientation="Horizontal" Background="Transparent">
							<Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
									Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
								<Path x:Name="Check" Data="M2,7 L5,10 L12,3" Stroke="White" StrokeThickness="1.8"
									  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
									  Visibility="Collapsed" Margin="2" />
							</Border>
							<ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
								<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
								<Setter TargetName="Check" Property="Visibility" Value="Visible" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SettingsThinScrollBar" TargetType="ScrollBar">
			<Setter Property="Width" Value="8" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollBar">
						<Grid Width="8" Background="Transparent">
							<Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
								<Track.DecreaseRepeatButton>
									<RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
								</Track.DecreaseRepeatButton>
								<Track.Thumb>
									<Thumb Width="8">
										<Thumb.Template>
											<ControlTemplate TargetType="Thumb">
												<Border Background="{DynamicResource FgFaint}" CornerRadius="4" Opacity="0.65" Margin="1,2" />
											</ControlTemplate>
										</Thumb.Template>
									</Thumb>
								</Track.Thumb>
								<Track.IncreaseRepeatButton>
									<RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
								</Track.IncreaseRepeatButton>
							</Track>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="SettingsScrollViewer" TargetType="ScrollViewer">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollViewer">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0"
													Margin="{TemplateBinding Padding}"
													Content="{TemplateBinding Content}"
													ContentTemplate="{TemplateBinding ContentTemplate}"
													CanContentScroll="{TemplateBinding CanContentScroll}" />
							<ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="8"
									   Orientation="Vertical" Cursor="Arrow"
									   Style="{StaticResource SettingsThinScrollBar}"
									   Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
									   Maximum="{TemplateBinding ScrollableHeight}"
									   ViewportSize="{TemplateBinding ViewportHeight}"
									   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,12">
			<TextBlock Text="二游日历" FontSize="18" FontWeight="SemiBold" />
			<TextBlock Text="卡池日历插件设置" FontSize="11" Foreground="{DynamicResource FgFaint}" Margin="0,3,0,0" />
			<TextBlock x:Name="LoadingText" Text="正在读取设置…" FontSize="12" Foreground="{DynamicResource FgDim}"
					   Margin="0,6,0,0" Visibility="Collapsed" />
			<TextBlock x:Name="SaveErrorText" FontSize="12" Foreground="{DynamicResource Danger}" Margin="0,6,0,0"
					   TextWrapping="Wrap" Visibility="Collapsed" />
		</StackPanel>

		<ScrollViewer Grid.Row="1" Style="{StaticResource SettingsScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<StackPanel>
				<!-- 自动刷新 -->
				<Border Style="{StaticResource Card}">
					<StackPanel>
						<CheckBox x:Name="AutoRefreshCheck" Content="自动刷新" FontSize="12"
								  Checked="OnAutoRefreshChanged" Unchecked="OnAutoRefreshChanged" />
						<StackPanel Orientation="Horizontal" Margin="0,10,0,0">
							<TextBlock Text="刷新频率" FontSize="12" VerticalAlignment="Center" />
							<ComboBox x:Name="RefreshIntervalCombo" Width="180" Margin="10,0,0,0" FontSize="12"
									  SelectionChanged="OnRefreshIntervalChanged" />
						</StackPanel>
						<TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
								   Text="在面板打开期间，按此频率自动刷新排期数据。" />
					</StackPanel>
				</Border>

				<!-- 实验特性 -->
				<Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
					<StackPanel>
						<CheckBox x:Name="NewPanelCheck" Content="实验性新版 UI（日程视图）" FontSize="12"
								  Checked="OnNewPanelChanged" Unchecked="OnNewPanelChanged" />
						<TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
								   Text="启用 DSH 实验版：日期胶囊、近期紧迫列表、时间轴日程表。默认关闭。" />
					</StackPanel>
				</Border>

				<!-- 条目管理 -->
				<Border Style="{StaticResource Card}">
					<StackPanel>
						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBlock Text="游戏列表" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
							<StackPanel Grid.Column="1" Orientation="Horizontal">
								<Button Content="重置排序" Style="{StaticResource SmallButton}" Click="OnResetOrder" Margin="0,0,6,0" />
								<Button Content="恢复条目" Style="{StaticResource SmallButton}" Click="OnRestoreEntries" />
							</StackPanel>
						</Grid>
						<TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
								   Text="「展示」控制显示；「↑↓」调整顺序；来源可切换或自定义；删除后可恢复条目。" />

						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="0.8*" />
								<ColumnDefinition Width="42" />
								<ColumnDefinition Width="44" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="88" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="游戏" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
							<TextBlock Grid.Column="1" Text="颜色" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
							<TextBlock Grid.Column="2" Text="展示" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
							<TextBlock Grid.Column="3" Text="卡池来源" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
							<TextBlock Grid.Column="4" Text="活动来源" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
							<TextBlock Grid.Column="5" Text="操作" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
						</Grid>

						<StackPanel x:Name="EntriesPanel" />
						<StackPanel x:Name="CustomEntryArea" Margin="0,8,0,0" />
					</StackPanel>
				</Border>

				<!-- 自检 -->
				<Border Style="{StaticResource Card}">
					<StackPanel>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="解析器自检" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
							<Button x:Name="SelfCheckButton" Content="开始自检" Style="{StaticResource SmallButton}"
									Margin="12,0,0,0" Click="OnSelfCheck" />
						</StackPanel>
						<TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
								   Text="逐个来源检查，区分「无匹配/未公布」与「失败」。" />
						<StackPanel x:Name="SelfCheckPanel" Margin="0,8,0,0" />
					</StackPanel>
				</Border>

				<TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
						   Text="数据来自各游戏官方公告、官方 Wiki 与第三方站；无数据时对应列留空。" />
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>
