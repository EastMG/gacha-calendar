<Window x:Class="GachaCalendar.Views.SettingsWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="设置 — 二游日历"
		Width="780" Height="780"
		MinWidth="720" MinHeight="600"
		WindowStartupLocation="CenterScreen"
		Background="{DynamicResource PanelBg}"
		Foreground="{DynamicResource Fg}"
		FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">
	<Window.Resources>
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource ChipBg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="14" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>
		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
		</Style>
		<Style x:Key="Hint" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style x:Key="SmallButton" TargetType="Button">
			<Setter Property="Padding" Value="10,3" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Background" Value="{DynamicResource PanelBg}" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.4" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,12">
			<TextBlock Text="二游日历" FontSize="18" FontWeight="SemiBold" />
			<TextBlock Text="卡池日历插件设置" FontSize="11" Foreground="{DynamicResource FgFaint}" Margin="0,3,0,0" />
			<TextBlock x:Name="SaveErrorText" FontSize="12" Foreground="{DynamicResource Danger}" Margin="0,6,0,0"
					   TextWrapping="Wrap" Visibility="Collapsed" />
		</StackPanel>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<StackPanel>
				<!-- 自动刷新 -->
				<Border Style="{StaticResource Card}">
					<StackPanel>
						<CheckBox x:Name="AutoRefreshCheck" Content="自动刷新" FontSize="12"
								  Checked="OnAutoRefreshChanged" Unchecked="OnAutoRefreshChanged" />
						<StackPanel Orientation="Horizontal" Margin="0,10,0,0">
							<TextBlock Text="刷新频率" FontSize="12" VerticalAlignment="Center" />
							<ComboBox x:Name="RefreshIntervalCombo" Width="180" Margin="10,0,0,0" FontSize="12"
									  SelectionChanged="OnRefreshIntervalChanged" />
						</StackPanel>
						<TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
								   Text="在面板打开期间，按此频率自动刷新排期数据。" />
					</StackPanel>
				</Border>

				<!-- 条目管理 -->
				<Border Style="{StaticResource Card}">
					<StackPanel>
						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBlock Text="游戏列表" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
							<StackPanel Grid.Column="1" Orientation="Horizontal">
								<Button Content="重置排序" Style="{StaticResource SmallButton}" Click="OnResetOrder" Margin="0,0,6,0" />
								<Button Content="恢复条目" Style="{StaticResource SmallButton}" Click="OnRestoreEntries" />
							</StackPanel>
						</Grid>
						<TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
								   Text="「展示」控制显示；「↑↓」调整顺序；来源可切换或自定义；删除后可恢复条目。" />

						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="0.9*" />
								<ColumnDefinition Width="44" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="88" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="游戏" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
							<TextBlock Grid.Column="1" Text="展示" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
							<TextBlock Grid.Column="2" Text="卡池来源" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
							<TextBlock Grid.Column="3" Text="活动来源" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
							<TextBlock Grid.Column="4" Text="操作" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
						</Grid>

						<StackPanel x:Name="EntriesPanel" />
						<StackPanel x:Name="CustomEntryArea" Margin="0,8,0,0" />
					</StackPanel>
				</Border>

				<!-- 自检 -->
				<Border Style="{StaticResource Card}">
					<StackPanel>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="解析器自检" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
							<Button x:Name="SelfCheckButton" Content="开始自检" Style="{StaticResource SmallButton}"
									Margin="12,0,0,0" Click="OnSelfCheck" />
						</StackPanel>
						<TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
								   Text="逐个来源检查，区分「无匹配/未公布」与「失败」。" />
						<StackPanel x:Name="SelfCheckPanel" Margin="0,8,0,0" />
					</StackPanel>
				</Border>

				<TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
						   Text="数据来自各游戏官方公告、官方 Wiki 与第三方站；无数据时对应列留空。" />
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>
